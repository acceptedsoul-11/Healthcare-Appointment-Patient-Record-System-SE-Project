MONGODB_URI=mongodb+srv://username:password@cluster/database
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Needed once to create the first administrator through POST /api/setup/admin. Keep server-side only.
ADMIN_SETUP_SECRET=replace-with-a-long-one-time-secret
# Private server-side upload directory. Keep this outside public/ and do not commit it.
PRIVATE_UPLOAD_DIR=.private-uploads
